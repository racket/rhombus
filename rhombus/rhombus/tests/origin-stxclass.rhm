#lang rhombus/and_meta

// binding arrows in this file checked by "origin.rhm"

match '1':
| '$(_ :: Int)':
    0

syntax_class NumStr:
  kind: ~sequence
| '$(x :: Int) $(y :: String)'

match '1 "two" !'
| '$(ns :: NumStr) !':
    ns.x +& ns.y

syntax_class NumStrGroup:
  kind: ~group
| '$(x :: Int) $(y :: String)'

match '1 "two"'
| '$(ns :: NumStrGroup)':
    ns.x +& ns.y

match '1 "two"'
| '1 $(g :: Group)':
    g

syntax_class_clause.macro 'splice:
                             $clause
                             ...':
  ': $clause
     ...'

syntax_class JustTerm:
  splice:
    kind: ~term
  splice:
    splice:
      fields: t
    root_swap: t match
    description: "just a term"
  error_mode: ~opaque
| '$t'

syntax_class_clause.macro 'splice_alt:
                             $clause
                             ...
                           | $pat
                           | ...':
  ': $clause
     ...
   | $pat
     ...'

syntax_class JustTermToo:
  splice_alt:
    splice:
      kind: ~term
    splice:
      splice:
        fields: t
      root_swap: t match
      description: "just a term too"
    error_mode: ~opaque
  | '$t'
