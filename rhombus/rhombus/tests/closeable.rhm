#lang rhombus

check:
  "x" is_a Closeable ~is #false
  Port.Input.open_string("x") is_a Closeable ~is #true
  Port.Output.open_string() is_a Closeable ~is #true

check:
  ~eval
  class Thing():
    implements Closeable
  ~throws "final class cannot have abstract methods"

check:
  ~eval
  interface Closeable2:
    method close(): #void
  class Thing():
    implements:
      Closeable
      Closeable2
  ~throws "method supplied by multiple superinterfaces and not overridden"

check:
  ~eval
  use_static
  class Thing():
    implements Closeable
    override close(x = 1): #void
  (Thing() :: Closeable).close(1)
  ~throws values("wrong number of arguments in method call",
                 "based on static information")

block:
  use_static
  class Thing():
    implements Closeable
    override method close(): println("bye")

  check: Thing() ~is_a Closeable

  check:
    (Thing() :: Closeable).close()
    ~prints "bye\n"

  check:
    Thing().close()
    ~prints "bye\n"

  check:
    Closeable.let c = Thing()
    println("go")
    ~prints "go\nbye\n"

  check:
    Closeable.let c = Thing()
    c.close()
    println("go")
    ~prints "bye\ngo\nbye\n"

  check:
    Closeable.let c = dynamic(Thing())
    c.close()
    println("go")
    ~prints "bye\ngo\nbye\n"

  class Another():
    implements Closeable
    override method close(): println("bye too")

  check:
    Closeable.let (c1, c2) = values(Thing(), Another())
    println("go")
    ~prints "go\nbye\nbye too\n"

  check:
    Closeable.let values(c1, c2) = values(Thing(), Another())
    println("go")
    ~prints "go\nbye\nbye too\n"

  check:
    Closeable.let values(c1, c2) = values(Thing(), Another())
    c2.close()
    c1.close()
    println("go")
    ~prints "bye too\nbye\ngo\nbye\nbye too\n"

  check:
    Closeable.let values(c1, c2) = values(dynamic(Thing()), dynamic(Another()))
    c2.close()
    c1.close()
    println("go")
    ~prints "bye too\nbye\ngo\nbye\nbye too\n"

block:
  use_static
  class Weird():
    implements Closeable
    override method close(): values("I'm", "very", "weird")
  check:
    Weird() ~is_a Closeable
    Weird().close() ~matches (_, _, _)
    (Weird() :: Closeable).close() ~matches (_, _, _)
    Closeable.close(Weird()) ~is #void

check:
  Closeable.let c = 5
  #void
  ~throws values("Closeable.let: " ++ error.annot_msg(),
                 error.val(5).msg,
                 error.annot("Closeable").msg)

block:
  class A(val):
    implements Closeable
    override close(): #void
  check:
    Closeable.let c :: False = A(1)
    #void
    ~throws values("Closeable.let: " ++ error.annot_msg(),
                   error.val(A(1)).msg,
                   error.annot("False").msg)
  check:
    Closeable.let (c1 :: False, c2 :: False) = values(A(1), A(2))
    #void
    ~throws values("Closeable.let: values do not satisfy annotation",
                   error.vals(A(1), A(2)).msg,
                   error.annot("values(False, False)").msg)

// check multiple-value bindings support
block:
  import:
    rhombus/meta open
  bind.macro 'noop $b':
    b
  class A(val):
    implements Closeable
    override close(): #void
  check:
    Closeable.let noop (x, y, z) = values(A(1), A(2), A(3))
    x.val + y.val + z.val
    ~is 6

// check evaluation order of binding oncers
block:
  class A():
    implements Closeable
    override close(): #void
  check:
    Closeable.let c :: satisfying(block: println("one"); fun (_): #true):
      println("two"); A()
    #void
    ~prints "one\ntwo\n"
  check:
    Closeable.let (c1 :: satisfying(block: println("one"); fun (_): #true),
                   c2 :: satisfying(block: println("two"); fun (_): #true)):
      println("three"); values(A(), A())
    #void
    ~prints "one\ntwo\nthree\n"
