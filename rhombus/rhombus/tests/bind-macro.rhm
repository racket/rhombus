#lang rhombus/and_meta

block:
  import "static_arity.rhm"
  static_arity.check ~meta:
    bind_meta.unpack(s)
    bind_meta.unpack_values(s)
    bind_meta.unpack_info(s)
    bind_meta.pack(s)
    bind_meta.pack_values(s)
    bind_meta.pack_info(s)
    bind_meta.get_arity(s)
    bind_meta.get_info(s, stat_info)
    bind_meta.get_values_info(s, stat_infos)
    bind_meta.is_immediate(s)

// define a binding operator

bind.macro '$$ $n':
  '$n :: Int'

fun apply_interest($$ n):
  n * 1.05

check:
  apply_interest(7)
  ~is 7.3500000000000005

// define <> as revese-cons pattern
bind.macro '$a <> $b':
  bind_meta.pack('(build_reverse_cons_infoer,
                   ($a, $b))')

bind.infoer 'build_reverse_cons_infoer($si_in, ($a_in, $b_in))':
  def a = bind_meta.get_info(a_in, '()')
  def b = bind_meta.get_info(b_in, '()')
  match bind_meta.unpack_info(a)
  | '($a_ann, $a_id, $a_info, ($a_bind_info, ...), $a_oncer, $a_matcher, $a_evidence, $a_committer, $a_binder, $a_data)':
      match bind_meta.unpack_info(b)
      | '($b_ann, $b_id, $b_info, ($b_bind_info, ...), $b_oncer, $b_matcher, $b_evidence, $b_committer, $b_binder, $b_data)':
          '($("matching((_ :: " +& Syntax.unwrap(a_ann) +& ") <> (_ :: " +& Syntax.unwrap(b_ann) +& "))"),
            pair,
            (),
            ($a_bind_info, ..., $b_bind_info, ...),
            build_reverse_cons_once,
            build_reverse_cons_match,
            ($a_evidence, $b_evidence),
            build_reverse_cons_commit,
            build_reverse_cons_bind,
            ($a, $b, a_part, b_part))'

bind.oncer 'build_reverse_cons_once(($a, $b, $a_part_id, $b_part_id))':
  match bind_meta.unpack_info(a)
  | '($a_ann, $a_id, $a_info, $a_bind_infos, $a_oncer, $a_matcher, $_, $a_committer, $a_binder, $a_data)':
      match bind_meta.unpack_info(b)
      | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $_, $b_committer, $b_binder, $b_data)':
          '$a_oncer($a_data)
           $b_oncer($b_data)'

bind.matcher 'build_reverse_cons_match($in_id, ($a, $b, $a_part_id, $b_part_id),
                                       $IF, $success, $fail)':
  match bind_meta.unpack_info(a)
  | '($a_ann, $a_id, $a_info, $a_bind_infos, $a_oncer, $a_matcher, $a_evidence, $a_committer, $a_binder, $a_data)':
      match bind_meta.unpack_info(b)
      | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $b_evidence, $b_committer, $b_binder, $b_data)':
          '// check for pair an extract reversed pieces
           def (is_match, $a_part_id, $b_part_id):
             match $in_id
             | Pair.cons($b_id, $a_id):
                 values(#true, $a_id, $b_id)
             | ~else:
                 values(#false, #false, #false)
           // if a match, chain to a and b matchers
           $IF is_match
           | $a_matcher($a_part_id,
                        $a_data,
                        $IF,
                        $b_matcher($b_part_id,
                                   $b_data,
                                   $IF,
                                   $success,
                                   $fail),
                        $fail)
           | $fail
          '

bind.committer 'build_reverse_cons_commit($in_id, ($a_evidence, $b_evidence), ($a, $b, $a_part_id, $b_part_id))':
  match bind_meta.unpack_info(a)
  | '($a_ann, $a_id, $a_info, $a_bind_infos, $a_oncer, $a_matcher, $_, $a_committer, $a_binder, $a_data)':
      match bind_meta.unpack_info(b)
      | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $_, $b_committer, $b_binder, $b_data)':
          '$a_committer($a_part_id, $a_evidence, $a_data)
           $b_committer($b_part_id, $b_evidence, $b_data)'

bind.binder 'build_reverse_cons_bind($in_id, ($a_evidence, $b_evidence), ($a, $b, $a_part_id, $b_part_id))':
  match bind_meta.unpack_info(a)
  | '($a_ann, $a_id, $a_info, $a_bind_infos, $a_oncer, $a_matcher, $_, $a_committer, $a_binder, $a_data)':
      match bind_meta.unpack_info(b)
      | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $_, $b_committer, $b_binder, $b_data)':
          '$a_binder($a_part_id, $a_evidence, $a_data)
           $b_binder($b_part_id, $b_evidence, $b_data)'

// an expression operator that's consistent with the pattern
expr.macro '$a <> $b': 'Pair.cons($b, $a)'

def rx <> (ry :: Int) = "2" <> 1

check:
  rx
  ~is "2"


// binder that ultimately expands to a use of `def`
bind.macro 'simple $(id :: Identifier)':
  bind_meta.pack('(simple_infoer, $id)')

bind.infoer 'simple_infoer($si_in, $id)':
  '($(to_string(id)),
    $id,
    (),
    (($id, [], ())),
    simple_once,
    simple_match,
    (),
    simple_commit,
    simple_bind,
    $id)'

bind.oncer 'simple_once($id)':
  ''

bind.matcher 'simple_match($in_id, $id,
                           $IF, $success, $fail)':
  '$IF #true
   | $success
   | $fail'

bind.committer 'simple_commit($in_id, (), $id)':
  ''

bind.committer 'simple_bind($in_id, (), $id)':
  'def $id = $in_id'

check:
  def simple x = 10
  x
  ~is 10

check:
  let simple x = 11
  x
  ~is 11

check:
  block:
    let x = 12
    fun f(): x
    let simple x = 13
    fun g(): x
    [x, f(), g()]
  ~is [13, 12, 13]

// variants that use `values` binding
bind.macro 'simple2 $(id :: Identifier)':
  bind_meta.pack('(simple2_infoer, $id)')

bind.infoer 'simple2_infoer($si_in, $id)':
  '($(to_string(id)),
    $id,
    (),
    (($id, [], ())),
    simple_once,
    simple_match,
    (),
    simple_commit,
    simple2_bind,
    $id)'

bind.committer 'simple2_bind($in_id, (), $id)':
  'def ($id) = $in_id'

check:
  def simple2 x = 10
  x
  ~is 10

check:
  let simple2 x = 11
  x
  ~is 11

check:
  block:
    let x = 12
    fun f(): x
    let simple2 x = 13
    fun g(): x
    [x, f(), g()]
  ~is [13, 12, 13]

bind.macro 'simple3 $(id :: Identifier)':
  bind_meta.pack('(simple3_infoer, $id)')

bind.infoer 'simple3_infoer($si_in, $id)':
  '($(to_string(id)),
    $id,
    (),
    (($id, [], ())),
    simple_once,
    simple_match,
    (),
    simple_commit,
    simple3_bind,
    $id)'

bind.committer 'simple3_bind($in_id, (), $id)':
  'def values($id) = $in_id'

check:
  def simple3 x = 10
  x
  ~is 10

check:
  let simple3 x = 11
  x
  ~is 11

check:
  block:
    let x = 12
    fun f(): x
    let simple3 x = 13
    fun g(): x
    [x, f(), g()]
  ~is [13, 12, 13]

check:
  ~eval
  def not_good(10) = 10
  ~throws values("not_good",
                 "not bound as a macro")

check:
  ~eval
  import: rhombus/meta open
  bind.macro 'bad': '1; 2'
  def bad = 1
  ~throws "expected: single-group syntax object for binding"

check:
  ~eval
  import: rhombus/meta open
  bind.macro 'bad': 666
  def bad = 1
  ~throws "expected: single-group syntax object for binding"

expr.macro 'is_immediate $(bind :: bind_meta.Parsed) $()':
  let info = bind_meta.get_info(bind, '()')
  '$(bind_meta.is_immediate(info))'

check:
  is_immediate _ ~is #true
  is_immediate (_) ~is #true
  is_immediate x :: Any ~is #true
  is_immediate (_ :: Any) :: Any ~is #true
  is_immediate x :~ Int ~is #true
  is_immediate x :~ Set.later_of(Any) ~is #true
  is_immediate x :: assuming(Set) ~is #true

check:
  ~eval
  import: rhombus/meta open
  bind.macro 'noop':
    bind_meta.pack('(noop_infoer, ())')

  bind.infoer 'noop_infoer($si_in, ())':
    '"oops"'

  meta block:
    let '$(noop :: bind_meta.Parsed)' = 'noop'
    bind_meta.get_info(noop, '()')
  ~throws "noop_infoer: ill-formed unpacked binding info"

check:
  ~eval
  import: rhombus/meta open
  bind.macro 'noop $b':
    bind_meta.pack('(noop_infoer, $b)')

  bind.infoer 'noop_infoer($si_in, $b_in)':
    let b = bind_meta.get_info(b_in, '()')
    match bind_meta.unpack_info(b)
    | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $b_evidence, $b_committer, $b_binder, $b_data)':
        '($b_ann, $b_id, $b_info, $b_bind_infos, noop_once, noop_match, $b_evidence, noop_commit, noop_bind, $b)'

  bind.oncer 'noop_once($b)':
    match bind_meta.unpack_info(b)
    | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $_, $b_committer, $b_binder, $b_data)':
        class Oops()
        Oops()

  bind.matcher 'noop_match($in_id, $b,
                           $IF, $success, $fail)':
    match bind_meta.unpack_info(b)
    | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $b_evidence, $b_committer, $b_binder, $b_data)':
        '$b_matcher($in_id, $b_data,
                    $IF, $success, $fail)'

  bind.committer 'noop_commit($in_id, $b_evidence, $b)':
    match bind_meta.unpack_info(b)
    | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $b_evidence, $b_committer, $b_binder, $b_data)':
        '$b_committer($in_id, $b_evidence, $b_data)'

  bind.binder 'noop_bind($in_id, $b_evidence, $b)':
    match bind_meta.unpack_info(b)
    | '($b_ann, $b_id, $b_info, $b_bind_infos, $b_oncer, $b_matcher, $b_evidence, $b_committer, $b_binder, $b_data)':
        '$b_binder($in_id, $b_evidence, $b_data)'

  def noop x = 1
  ~throws "noop_once: cannot coerce value to syntax"

