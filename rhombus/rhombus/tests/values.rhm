#lang rhombus

check values(1, 2) ~is values(1, 2)
check values() ~is values()

block:
  let [x, ...] = [1, 2, 3]
  check values(x, ...) ~is values(1, 2, 3)

check values(1, ~x: "oops") ~throws "function does not accept keyword arguments"

block:
  use_static
  check values("apple")[0] ~is Char"a"
  let (x, y) = values("apple", 0)
  check x[0] ~is Char"a"
  check y > y ~is #false

block:
  use_static
  let [x :: String, ...] = ["a", "bc"]
  check values(x.length(), ...) ~is values(1, 2)
  check [values(x).length(), ...] ~is [1, 2]

block:
  let f = values(_)
  let g = values("one", _, "three")
  check f(10) ~is 10
  check g(10) ~is values("one", 10, "three")

check:
  ~eval
  "hello" :: values(String)
  ~throws "values: not allowed as an annotation"

check:
  ~eval
  values("hello", "world") :: values(String, String)
  ~throws "values: not allowed as an annotation"

check:
  "hello" matches values("hello")
  ~is #true

check:
  "hello" matches values(values("hello"))
  ~is #true

check:
  ~eval
  values("hello", "world") matches values("hello", "world")
  ~throws "values: multiple-value binding not allowed in single-value context"

check:
  ~eval
  values("hello", "world") matches values(values("hello", "world"))
  ~throws "values: multiple-value binding not allowed in single-value context"

check:
  match values("hello", "world")
  | values("hello", "world"): #true
  | ~else: #false
  ~is #true

check:
  ~eval
  match values("hello", "world")
  | values(values("hello", "world")): #true
  | ~else: #false
  ~throws "values: multiple-value binding not allowed in single-value context"
