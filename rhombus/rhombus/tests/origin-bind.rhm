#lang rhombus/and_meta

// binding arrows in this file checked by "origin.rhm"

class Posn(x, y)

fun f1(Posn(x, y :: Posn)):
  x + y + x

fun
| f2(Posn(x, y)):
    x + y
| f2([_ :: Posn]):
    0
| f2([_ :: Posn, ...]):
    0
| f2(PairList[_ :: Posn, _ :: Posn, ...]):
    0

operator ((x :~ Posn) &&.) :~ Posn:
  x
operator ((x :~ Posn) &&& (y :~ Posn)) :~ Posn:
  x
operator (.&& (y :~ Posn)) :~ Posn:
  y
operator &&? :~ Posn
| ((x :~ Posn) &&?) :~ Posn:
    x
| (&&? (y :~ Posn)) :~ Posn:
    y
operator &&?? :~ Posn
| ((x :~ Posn) &&?? (y :~ Posn)) :~ Posn:
    y
| (&&?? (x :~ Posn)) :~ Posn:
    x

match 1
| y && x :: Int: #void

1 matches ((_ :: PosInt) || (_ :: NegInt) && !2)

List[1, 2, 3] matches (List[x, y, z] where #%literal 6 = x + y + z)
List[1, 2, 3] matches (List[x, y, z] where:
                         k = x + y + z
                         #%literal 6 = k)

List[1, 2, 3] matches (List[x, y, z] when x + y + z == 6)
List[1, 2, 3] matches (List[x, y, z] when:
                         x + y + z == 6)

List[1, 2, 3] matches (List[x, y, z] unless x + y + z != 6)
List[1, 2, 3] matches (List[x, y, z] unless:
                         x + y + z != 6)

match values(1, 2, 3)
| values(values(#%literal 1), values(#%literal 2), values(#%literal 3)):
    "yes"
